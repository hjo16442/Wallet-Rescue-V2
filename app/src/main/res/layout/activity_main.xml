<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outputScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wallet Rescue — تولیدکننده BIP39"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="عبارت بازیابی استاندارد با تصادفی‌ساز امن گوشی ساخته می‌شود. اینترنت برنامه فعال است، اما عبارت‌ها به اینترنت یا سرور ارسال نمی‌شوند."
            android:textSize="14sp" />
        <RadioGroup
            android:id="@+id/lengthGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@id/radio12"
            android:layout_marginTop="16dp">
            <RadioButton
                android:id="@+id/radio12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۱۲ کلمه" />
            <RadioButton
                android:id="@+id/radio24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۲۴ کلمه" />
        </RadioGroup>
        <EditText
            android:id="@+id/countInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="تعداد عبارت‌ها (۱ تا ۱۰)"
            android:inputType="number"
            android:text="1" />
        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تولید عبارت جدید" />
        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توقف"
            android:enabled="false" />
        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ذخیره TXT"
            android:enabled="false" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="آماده"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/counterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="تعداد تولیدشده: 0" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="عبارت بازیابی — محرمانه"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F1F1F1"
            android:padding="14dp"
            android:textIsSelectable="true"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:text="هنوز عبارتی تولید نشده است" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="هشدار امنیتی: هرکس این ۱۲ یا ۲۴ کلمه را داشته باشد می‌تواند به دارایی کیف پول دسترسی پیدا کند. از صفحه عکس نگیرید و عبارت را برای هیچ‌کس نفرستید."
            android:textColor="#B00020"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>