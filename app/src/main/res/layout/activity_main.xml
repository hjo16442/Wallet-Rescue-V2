<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تولیدکننده آفلاین عبارت بازیابی"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="طول عبارت را انتخاب کنید:"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/lengthGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/words12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="۱۲ کلمه" />

            <RadioButton
                android:id="@+id/words24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۲۴ کلمه" />
        </RadioGroup>

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تولید عبارت جدید" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="آماده — کاملاً آفلاین"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phraseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F1F3F5"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="عبارت بازیابی پس از زدن دکمه نمایش داده می‌شود."
            android:textIsSelectable="true"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="هشدار امنیتی: عبارت را روی کاغذ یادداشت کنید. آن را برای هیچ‌کس نفرستید و در تصویر یا فضای ابری ذخیره نکنید. هر بار فقط یک عبارت جدید برای ساخت کیف پول خودتان تولید می‌شود."
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
