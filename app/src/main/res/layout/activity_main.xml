<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wallet Rescue V2" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="ساخت کیف پول امن به‌صورت آفلاین (BIP39) — عبارت بازیابی محرمانه است."/>
<Button android:id="@+id/create12Btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="شروع — ساخت کیف پول ۱۲ کلمه‌ای"/>
<Button android:id="@+id/create24Btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ساخت کیف پول ۲۴ کلمه‌ای"/>
<Button android:id="@+id/copyBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="کپی عبارت بازیابی" android:enabled="false"/>
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آماده" android:paddingTop="8dp" android:textStyle="bold"/>
<TextView android:id="@+id/walletText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textIsSelectable="true" android:textSize="14sp" android:padding="8dp" android:background="#F4F4F4"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#999999"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بررسی موجودی آدرس عمومی بیت‌کوین (BTC Mainnet)" android:textStyle="bold" android:paddingTop="10dp"/>

<EditText android:id="@+id/inputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="3" android:maxLines="6" android:gravity="top|start" android:fontFamily="monospace" android:inputType="textMultiLine|textNoSuggestions" android:hint="آدرس عمومی بیت‌کوین را در هر خط وارد کنید"/>
<Button android:id="@+id/startBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بررسی موجودی بیت‌کوین"/>
<Button android:id="@+id/stopBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="توقف بررسی" android:enabled="false"/>
<TextView android:id="@+id/speedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=" "/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نتیجه بررسی:" android:textStyle="bold"/>
<ScrollView android:id="@+id/outputScroll" android:layout_width="match_parent" android:layout_height="220dp" android:background="#F5F5F5" android:padding="8dp">
<TextView android:id="@+id/outputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textIsSelectable="true" android:textSize="13sp"/>
</ScrollView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="امنیت: عبارت بازیابی را عکس نگیرید یا در پیام‌رسان نفرستید. بررسی عمومی فقط برای BTC Mainnet در دسترس است؛ بکاپ رمزگذاری‌شده هنوز پیاده‌سازی نشده است."/>
</LinearLayout></ScrollView>